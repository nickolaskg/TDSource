# Public HTTPS address used to open TDSource.
# For an initial LAN-only health check, this may temporarily be
# http://SERVER_LAN_IP:8787, but Webex sign-in requires HTTPS.
APP_ORIGIN=https://tdsource.example.lan
APPROVED_EMAIL_DOMAINS=tdsynnex.com
SESSION_COOKIE_NAME=__Host-tds_session

# This exact URL must also be registered in the Webex OAuth application.
WEBEX_REDIRECT_URI=https://tdsource.example.lan/api/auth/webex/callback

# Generate a long random value and keep it unchanged after users begin signing in.
SESSION_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Webex OAuth application.
WEBEX_CLIENT_ID=replace-with-webex-client-id
WEBEX_CLIENT_SECRET=replace-with-webex-client-secret

# Webex capture identity and signed webhook.
WEBEX_BOT_ACCESS_TOKEN=replace-with-webex-access-token
WEBEX_BOT_NAME=replace-with-webex-bot-name
WEBEX_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Supabase project. Use a server-side secret/service-role key, never the anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key

# Gemini configuration.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_AI_API=replace-with-google-ai-studio-api-key

# Optional model context size.
LLM_CONTEXT_TOKENS=16384

# Ollama alternative. When using Ollama, change LLM_PROVIDER and LLM_MODEL above,
# then uncomment this line. Use an address reachable from inside the container.
# LLM_BASE_URL=http://192.168.1.42:11434
